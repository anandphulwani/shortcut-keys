{
  "schemaVersion": 2,
  "passwords": {
    "password": "replace-me",
    "password_Shift": "replace-me",
    "password_Alt": "replace-me"
  },
  "autofillRules": [
    {
      "id": "radmin-security",
      "enabled": 1,
      "target": "native",
      "match": {
        "class": "#32770",
        "titleRegex": "i)^Radmin security:"
      },
      "presentation": {
        "mode": "offscreen",
        "edge": "top",
        "margin": 64,
        "restore": 1
      },
      "steps": [
        {
          "id": "username",
          "control": "Edit1",
          "action": "setText",
          "inputMethod": "type",
          "keyDelayMs": 10,
          "value": "User",
          "verify": "textEquals"
        },
        {
          "id": "password",
          "control": "Edit2",
          "action": "setText",
          "inputMethod": "paste",
          "valueFrom": "passwords.password",
          "verify": "controlExists"
        },
        {
          "id": "save-user",
          "control": "Button1",
          "action": "setChecked",
          "value": 1,
          "dependsOn": "password",
          "verify": "checkedEquals"
        },
        {
          "id": "submit",
          "control": "Button2",
          "action": "click",
          "dependsOn": "save-user",
          "verify": "windowClosed",
          "timeoutMs": 5000
        }
      ]
    },
    {
      "id": "example-browser-login",
      "enabled": 0,
      "target": "browser",
      "match": {
        "browser": "edge",
        "origin": "https://example.com",
        "pathRegex": "^/login(?:\\?.*)?$"
      },
      "steps": [
        {
          "id": "password",
          "selector": "input[type=password]",
          "action": "setText",
          "valueFrom": "passwords.password",
          "verify": "controlExists"
        }
      ]
    }
  ]
}
